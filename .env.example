# ==============================================================================
# Neon Cloud PostgreSQL & Authentication Configuration
# ==============================================================================
# 1. Sign up or log in to https://neon.tech
# 2. Create a new PostgreSQL project (e.g. 'tamilnadu-rice-yield')
# 3. Copy your Connection String from the Neon Console dashboard
# 4. Set DATABASE_URL below (ensure sslmode=require is included)

DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-your-project-id.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT Secret Key for Session Authentication (Change to a random 32+ character string in production)
JWT_SECRET=tamilnadu-rice-yield-dss-neon-secret-key-2026
